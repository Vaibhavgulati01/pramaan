# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Data & artifacts — never commit real dataset images or bulk downloads.
# See scripts/check_image_licenses.py for the CI-enforced allowlist on
# what image files ARE permitted to be committed (self-authored / synthetic only).
data/raw/
data/cache/
data/full/
*.faiss
*.index

# Reports are regenerated by `pramaan report` / `pramaan eval` — only the
# committed, allowlisted tables/figures under reports/{smoke,dev,full}/ that
# scripts explicitly write are tracked; scratch output is not.
reports/**/scratch/

# Secrets / local env
.env
.env.*
*.local.yaml

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
.claude/

# Node (GIF tooling in Phase 8)
node_modules/

# Model artifacts (regenerated by `pramaan train`)
*.pkl
*.bin
*.onnx
!benchmarks/baselines/**/*.onnx
