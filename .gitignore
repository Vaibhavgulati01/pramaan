# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Data & artifacts — never commit real dataset images, bulk downloads, or
# the constructed corpus (raw/, dev/, full/ all included): ABO/GenImage
# are CC BY-NC(-SA), the corpus's per-claim manifest carries synthetic
# identity fields, and neither belongs in a public git history regardless
# of scale. See docs/DATA_CARD.md and scripts/check_image_licenses.py
# (Phase 6) for the CI-enforced allowlist on what image files ARE
# permitted to be committed (self-authored / synthetic-placeholder only).
data/
*.faiss
*.index

# Reports are regenerated by `pramaan report` / `pramaan eval` — only the
# committed, allowlisted tables/figures under reports/{smoke,dev,full}/ that
# scripts explicitly write are tracked; scratch output is not.
reports/**/scratch/

# smoke output is regenerated by CI on every push and is documented as
# never reportable (docs/EVALUATION_PROTOCOL.md), so committing it only
# produces diff churn and invites someone to quote a CI-budget number.
# reports/smoke/README.md stays tracked to explain the empty directory.
reports/smoke/*
!reports/smoke/README.md

# Secrets / local env
.env
.env.*
*.local.yaml

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
.claude/

# Node (GIF tooling in Phase 8)
node_modules/

# Model artifacts (regenerated by `pramaan train`)
*.pkl
*.bin
*.onnx
!benchmarks/baselines/**/*.onnx
